# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force LF on shell scripts and unix tools
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Force CRLF on Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# KiCad S-expression files and tables
*.kicad_sch text eol=lf filter=kicad_sch_cleaner
*.kicad_pcb text eol=lf filter=kicad_pcb_cleaner
*.kicad_pro text eol=lf filter=kicad_pro_cleaner
*.kicad_dru text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*-lib-table text eol=lf

# Binary file types
*.step binary
*.stp binary
*.wrl binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
